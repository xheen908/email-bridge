# Express Server Port
PORT=3000

# API Key für die Absicherung der Endpunkte gegen unbefugten Zugriff (Wird im Header X-API-Key erwartet)
BRIDGE_API_KEY=dein_geheimer_api_schluessel_hier_eintragen

# ==========================================
# Stalwart Mail Server Konfiguration (SMTP)
# ==========================================
# Host: z.B. mail.deinedomain.de (oder localhost falls der Docker direkt auf dem Mail-Server läuft)
STALWART_HOST=mail.deinedomain.de
# Port: 465 (für direktes SSL/TLS) oder 587/25 (für STARTTLS)
STALWART_SMTP_PORT=465
STALWART_SMTP_SECURE=true
STALWART_USER=user@deinedomain.de
STALWART_PASS=dein_geheimes_passwort
DEFAULT_FROM_EMAIL=user@deinedomain.de

# ==========================================
# Stalwart Mail Server Konfiguration (IMAP)
# ==========================================
# Port: 993 (Standard für IMAP über SSL/TLS)
STALWART_IMAP_PORT=993
STALWART_IMAP_SECURE=true
# Optional: Spezifischer Pfad oder Ordnername für versendete Mails (falls Special-Use \Sent nicht gefunden wird)
IMAP_SENT_FOLDER=Sent
