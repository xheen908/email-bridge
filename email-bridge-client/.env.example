# Lokaler Express Server Port (im internen Docker- oder App-Netzwerk)
PORT=3000

# URL des externen Email Bridge Servers (auf dem Mail-VPS)
REMOTE_SERVER_URL=https://mail.deinedomain.de/api/v1

# API Key für die Authentifizierung beim externen Bridge Server
REMOTE_API_KEY=dein_geheimer_api_schluessel_hier_eintragen

# Optionales lokales Secret für interne Anfragen im Netzwerk an den Client
LOCAL_API_KEY=

# Standard Absender-E-Mail falls keine spezifische im Request angegeben wird
DEFAULT_FROM_EMAIL=user@deinedomain.de

# Maximale Anzahl an Retries bei Netzwerkfehlern zur Remote Bridge
MAX_RETRIES=3
